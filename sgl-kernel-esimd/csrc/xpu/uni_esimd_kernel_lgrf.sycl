ESIMD_INLINE void esimd_mul_impl(uint8_t* a, uint8_t* b, uint8_t* c, int64_t len, nd_item<1>& ndi) {

  __ESIMD_NS::slm_init(16 * sizeof(fp16)); 

  int global_idx = ndi.get_group(0);
  int local_range = ndi.get_local_range(0);
  int local_idx = ndi.get_local_id(0);
  int inputOffset = (global_idx * local_range + local_idx) * 128 * sizeof(fp16);
  simd<fp16, 128> a_fp16;
  simd<fp16, 128> b_fp16;
  simd<fp16, 128> c_fp16;


      a_fp16.template bit_cast_view<uint8_t>().template select<256, 1>(0) =
              __ESIMD_ENS::lsc_block_load<
              uint8_t,
              256,
              __ESIMD_ENS::lsc_data_size::default_size,
              __ESIMD_ENS::cache_hint::cached,
              __ESIMD_ENS::cache_hint::cached>((uint8_t*)a + inputOffset);

      b_fp16.template bit_cast_view<uint8_t>().template select<256, 1>(0) =
              __ESIMD_ENS::lsc_block_load<
              uint8_t,
              256,
              __ESIMD_ENS::lsc_data_size::default_size,
              __ESIMD_ENS::cache_hint::cached,
              __ESIMD_ENS::cache_hint::cached>((uint8_t*)b + inputOffset);

      c_fp16 = a_fp16 * b_fp16;

    // if (local_idx < 16)
    {
      __ESIMD_ENS::lsc_block_store<
        fp16,
        128,
        __ESIMD_ENS::lsc_data_size::default_size,
        __ESIMD_ENS::cache_hint::write_back,
        __ESIMD_ENS::cache_hint::write_back>((fp16*)c + 128 * (global_idx * local_range + local_idx), c_fp16.select<128, 1>(0));
    }
    barrier();
    
}

void esimd_mul(uint8_t* a, uint8_t* b, uint8_t* c, int64_t len, sycl::queue& q){
    sycl::range<1> LocalRange(16); 
    sycl::range<1> GlobalRange(len / 128);

    sycl::nd_range<1> Range(GlobalRange, LocalRange);
    printf("--- global, local: %d, %d\n", 16, len / 128);
    sycl::event e;
    try {
      {
        e = q.submit([&](handler& cgh) {
        cgh.parallel_for(Range, [=](nd_item<1> ndi) SYCL_ESIMD_KERNEL{
              esimd_mul_impl(a, b, c, len, ndi);
            });
         });
      }
    } catch (sycl::exception const &e) {
      std::cout << "SYCL exception caught: " << e.what() << '\n';
      return;
    }
}

at::Tensor esimd_kernel_mul_lgrf(
    at::Tensor _p0,
    at::Tensor _p1,
    at::Tensor _p2,
    //at::Tensor _p3,
    //at::Tensor _p4,
    //at::Tensor _p5,
    //at::Tensor _p6,
    //at::Tensor _p7,
    //at::Tensor _p8,
    //at::Tensor _p9,

    int64_t i0,
    int64_t i1
    //int64_t i2,
    //int64_t i3,
    //int64_t i4,
    //int64_t i5,
    //int64_t i6,
    //int64_t i7,
    //int64_t i8,
    //int64_t i9,

    //float f0,
    //float f1,
    //float f2,
    //float f3,
    //float f4
    )
    {
    auto p0 = reinterpret_cast<uint8_t*>(_p0.data_ptr<at::Half>());
    auto p1 = reinterpret_cast<uint8_t*>(_p1.data_ptr<at::Half>());
    auto p2 = reinterpret_cast<uint8_t*>(_p2.data_ptr<at::Half>());
    //auto p3 = reinterpret_cast<uint8_t*>(_p3.data_ptr<uint8_t>());
    //auto p4 = reinterpret_cast<uint8_t*>(_p4.data_ptr<uint8_t>());
    //auto p5 = reinterpret_cast<uint8_t*>(_p5.data_ptr<uint8_t>());
    //auto p6 = reinterpret_cast<uint8_t*>(_p6.data_ptr<uint8_t>());
    //auto p7 = reinterpret_cast<uint8_t*>(_p7.data_ptr<uint8_t>());
    //auto p8 = reinterpret_cast<uint8_t*>(_p8.data_ptr<uint8_t>());
    //auto p9 = reinterpret_cast<uint8_t*>(_p9.data_ptr<uint8_t>());
    auto stream = at::xpu::getCurrentXPUStream();
    auto dpcpp_queue = stream.queue();

      switch(i0){
        case 1000:   // rms norm
          esimd_mul(p0, p1, p2, i1, dpcpp_queue);
          break;
        default:
          printf("---------- esimd uni-lgrf kernel op not supported, op is %lld ----------\n", i0);
          break;
      }
      return _p2;
    }

//template <uint32_t QK_DIM, uint32_t V_DIM>
bool runSdpFusion_mla(
      queue& q,
      uint8_t* q_extend,
      uint8_t* k_extend,
      uint8_t* v_extend,
      uint8_t* o_extend,
      uint8_t* k_buffer,
      uint8_t* v_buffer,
      uint8_t* kv_indices,
      unsigned num_heads,
      unsigned num_heads_kv,
      unsigned extend_seq_len,
      unsigned prefix_seq_len,
      unsigned qk_dim,
      unsigned v_dim,
      float attn_scale)
  {

  int qhead_div_kvhead = num_heads / num_heads_kv;

  int q_reduce_num = (extend_seq_len + (8 * SDP_THREAD - 1)) / (8 * SDP_THREAD);
  //printf("q_reduce_num %d num_heads %d,  qk_dim %d , v_dim %d !!\n", q_reduce_num, num_heads, qk_dim, v_dim);

  sycl::range<3> GlobalRange(num_heads / qhead_div_kvhead, qhead_div_kvhead, q_reduce_num * SDP_THREAD); // num_head x kv_len, batch size
  sycl::range<3> LocalRange(1, 1, SDP_THREAD); // kv_len, x
  sycl::nd_range<3> Range(GlobalRange, LocalRange);

  sycl::event e;
  try {
          e = q.submit([&](handler& cgh) {
          cgh.parallel_for<class mla_gemm_esimd>(Range, [=](nd_item<3> ndi) SYCL_ESIMD_KERNEL{
              SDP_xmx_gemm(q_extend, k_extend, v_extend, o_extend, k_buffer, v_buffer, kv_indices, num_heads, num_heads_kv,extend_seq_len, prefix_seq_len,attn_scale, ndi);
            });
          });
  } catch (sycl::exception const &e) {
    std::cout << "SYCL exception caught: " << e.what() << '\n';
    return false;
  }

  bool success = true;
  return success;
}

void esimd_kernel_sdp_mla(
      uint8_t* q_extend,
      uint8_t* k_extend,
      uint8_t* v_extend,
      uint8_t* k_buffer,
      uint8_t* v_buffer,
      //uint8_t* qo_indptr,
      //uint8_t* kv_indptr,
      uint8_t* kv_indices, //for 1 batch 
      uint8_t* o_extend,
      int64_t num_heads,
      int64_t num_heads_kv,
      int64_t extend_seq_len,
      int64_t prefix_seq_len,
      //int64_t batch_idx,
      int64_t qk_dim,
      int64_t v_dim,
      float attn_scale,

  sycl::queue& dpcpp_queue)
  {
    runSdpFusion_mla(dpcpp_queue, q_extend, k_extend, v_extend, o_extend, k_buffer, v_buffer, kv_indices, num_heads, num_heads_kv,extend_seq_len, prefix_seq_len,qk_dim,v_dim ,attn_scale );
  }

void esimd_kernel_dsa_qk_attn(
    uint8_t* query,    // [b, 64, 128]
    uint8_t* k_cache,  // [b, k_cache_batch_stride, 128]
    uint8_t* k_scale,  // [b, k_cache_batch_stride]
    uint8_t* weights,  // [b, 1, 64]
    uint8_t* index_score_rsv,
    int64_t batch_num,
    int64_t k_cache_batch_stride,
    int64_t seq_lens_cpu_addr,  // [3260, 5136,   10,  778]
sycl::queue& dpcpp_queue)
{
  // assume q heads 64   k head 1    head_dim is 128
  int64_t* seq_lens_cpu = (int64_t*)seq_lens_cpu_addr;

  int64_t seq_lens_kernel[8] = {0};
  int64_t k8_num_start_kernel[9] = {0};

  int k8_num_cumsum = 0;
  for (int b = 0; b < batch_num; b++)
  {
    int cur_seq_len = seq_lens_cpu[b];
    int cur_k8_num = (cur_seq_len + 7) / 8;
    k8_num_start_kernel[b] = k8_num_cumsum;
    k8_num_cumsum += cur_k8_num;
    seq_lens_kernel[b] = cur_seq_len;

    // printf("cur_seq_len = %d\n", cur_seq_len);
    // printf("cur_k8_num = %d\n", cur_k8_num);
    // printf("k8_num_start_kernel[%d] = %d\n", b, k8_num_start_kernel[b]);
  }
  k8_num_start_kernel[batch_num] = k8_num_cumsum;

  // printf("k8_num_cumsum = %d\n", k8_num_cumsum);

  sycl::range<1> GlobalRange(k8_num_cumsum);
  sycl::range<1> LocalRange(1);
  sycl::nd_range<1> Range(GlobalRange, LocalRange);

  dpcpp_queue.submit([&](handler& cgh) {
    cgh.parallel_for(
      Range, [=](nd_item<1> ndi) SYCL_ESIMD_KERNEL {

        int gid = ndi.get_group(0);

        constexpr int index_score_rsv_stride = 163840;

        int cur_batch = 0;
        bool isLast = false;
        for (int b = 1; b < batch_num+1; b++)
        {
          if (gid < k8_num_start_kernel[b])
          {
            if (gid == k8_num_start_kernel[b] - 1)
            {
              isLast = true;
            }

            gid = gid - k8_num_start_kernel[b-1];
            break;
          } 
          cur_batch++;
        }
        
        // q [b, 64, 128] => [b, 4, 16, 128] => [b, 4, 16, 4, 32] => [b, 4, 4(-), _16, 32_]  16x32 VNNI
        // k [b, k_cache_batch_stride, 128] => [b, cur_seq_len, 128] => [b, cur_seq_len / 8, 8, 128] => [b, k8_num, 8, 128]
        // => [b, k8_num, 8, 4, 32] => => [b, k8_num, 4, 8, 32] => [b, k8_num, 4(-), _8, 32_]  8x16 2D
        // o [b, k8_num, 8, 64] => o [b, k8_num, 8, 4, 16]  => o [b, k8_num, 4, _8, 16_]

        // k scale len 8
        // o dequant and shuffle back to [b, k8_num, 8, 4, 16] => [b, k8_num, 8, 64]
        // weight [b, 64]
        // o relu and * weight and sum [b, k8_num, 8] => write out

        // simd<int8_t, 4*4*16*32> q_cur;
        simd<int8_t, 4*16*32> q_cur;
        simd<int8_t, 4*8*32> k_cur;
        simd<float, 8> k_scale_cur = block_load<fp16, 8>((fp16*)k_scale + cur_batch * k_cache_batch_stride + gid * 8);
        simd<fp16, 64> weight_cur = block_load<fp16, 64>((fp16*)weights + cur_batch * 64);
        simd<int32_t, 4*8*16> o_int_cur;
        simd<fp16, 8*4*16> o_cur;  // should be dequant and shuffled
        simd<fp16, 8> o_final;

        int64_t q_base_offset = (cur_batch * 64 * 128) * sizeof(int8_t);
        simd<uint32_t, 16> gather_offset(q_base_offset, 128*sizeof(int8_t));

        // #pragma unroll
        // for (int i = 0; i < 4; i++)
        // {
        //   #pragma unroll
        //   for (int k = 0; k < 4; k++)
        //   {
        //     q_cur.template bit_cast_view<uint32_t>().template select<16*32/4, 1>(i*4*16*32/4 + k*16*32/4) =
        //     __ESIMD_ENS::lsc_gather<
        //     uint32_t,
        //     8,
        //     __ESIMD_ENS::lsc_data_size::u32,
        //     __ESIMD_ENS::cache_hint::cached,
        //     __ESIMD_ENS::cache_hint::cached,
        //     16,
        //     uint32_t
        //     >((uint32_t*)query, gather_offset + (i*16*128 + k*32) * sizeof(int8_t));
        //   }
        // }

        int64_t k_base_offset = (cur_batch * k_cache_batch_stride * 128 + gid * 8 * 128) * sizeof(int8_t);
        #pragma unroll
        for (int k = 0; k < 4; k++)
        {
          k_cur.template select<32*8, 1>(k*32*8) = __ESIMD_ENS::lsc_load_2d<
            int8_t, 32, 8, 1,  //32x8
            false, false,
            __ESIMD_ENS::cache_hint::cached,
            __ESIMD_ENS::cache_hint::cached>((int8_t*)k_cache + k_base_offset,
                128 - 1, 8 - 1, 128 - 1,
                k * 32, // X cord
                0);  // Y cord
        }
        
        #pragma unroll
        for (int i = 0; i < 4; i++)
        {
          simd<int32_t, 8*16> cc_xmx{0};

          #pragma unroll
          for (int k = 0; k < 4; k++)
          {
            q_cur.template bit_cast_view<uint32_t>().template select<16*32/4, 1>(k*16*32/4) =
              __ESIMD_ENS::lsc_gather<
              uint32_t,
              8,
              __ESIMD_ENS::lsc_data_size::u32,
              __ESIMD_ENS::cache_hint::cached,
              __ESIMD_ENS::cache_hint::cached,
              16,
              uint32_t
              >((uint32_t*)query, gather_offset + (i*16*128 + k*32) * sizeof(int8_t));
          }

          #pragma unroll
          for (int k = 0; k < 4; k++)
          {
            // dpas
            simd<int8_t, 8*32> bb_xmx{0};
            simd<int8_t, 16*32> aa_xmx{0};

            bb_xmx = k_cur.template select<8*32,1>(k*8*32);
            aa_xmx = q_cur.template select<16*32, 1>(k*16*32);
            cc_xmx = sycl::ext::intel::esimd::xmx::dpas<8, 8, int32_t, int32_t, int8_t, int8_t>(cc_xmx, aa_xmx, bb_xmx);
          }
          o_int_cur.template select<8*16,1>(i*8*16) = cc_xmx;
        }

        // dequant and shuffle to [b, k8_num, 8, 4, 16]
        #pragma unroll
        for (int i = 0; i < 4; i++)
        {
          #pragma unroll
          for (int j = 0; j < 8; j++)
          {
            simd<float, 16> o_temp = o_int_cur.template select<16,1>(i*8*16 + j*16);
            o_temp.template select<16,1>(0) = o_temp.template select<16,1>(0) * k_scale_cur[j];
            o_cur.template select<16,1>(i*16 + j*4*16) = o_temp;
          }
        }

        // #pragma unroll
        // for (int j = 0; j < 8; j++)
        // {
        //   simd<fp16, 64> o_final2 = o_cur.template select<64, 1>(64*j);
        //   block_store<fp16, 64>((fp16*)index_score_rsv + gid * 8 * 64 + 64*j, o_final2);
        // }

        // relu and * weight and sum
        #pragma unroll
        for (int j = 0; j < 8; j++)
        {
          simd<fp16, 64> o_temp = o_cur.template select<64,1>(j*64);
          simd_mask<64> mask = o_temp > 0;
          o_temp.merge(o_temp, 0, mask);
          o_final[j] = sycl::ext::intel::esimd::reduce<fp16, fp16, 64, std::plus<>>(
            o_temp * weight_cur, std::plus<>());
        }
 
        int cur_seq_len = seq_lens_kernel[cur_batch];
        int cur_rest = cur_seq_len % 8;
        int last_k_num = 8;
        if (isLast && cur_rest != 0)
        {
          last_k_num = cur_rest;

          for (int i = 0; i < last_k_num; i++)
          {
            block_store<fp16, 1>((fp16*)index_score_rsv + gid * 8 + cur_batch * index_score_rsv_stride + i, o_final[i]);
          }
        }
        else
        {
          block_store<fp16, 8>((fp16*)index_score_rsv + gid * 8 + cur_batch * index_score_rsv_stride, o_final);
        }
      });
  });


}

at::Tensor esimd_kernel_uni_lgrf(
    at::Tensor _p0,
    at::Tensor _p1,
    at::Tensor _p2,
    at::Tensor _p3,
    at::Tensor _p4,
    at::Tensor _p5,
    at::Tensor _p6,
    at::Tensor _p7,
    at::Tensor _p8,
    at::Tensor _p9,

    int64_t i0,
    int64_t i1,
    int64_t i2,
    int64_t i3,
    int64_t i4,
    int64_t i5,
    int64_t i6,
    int64_t i7,
    int64_t i8,
    int64_t i9,

    double f0,
    double f1,
    double f2,
    double f3,
    double f4
    )
    {
    auto p0 = reinterpret_cast<uint8_t*>(_p0.data_ptr());
    auto p1 = reinterpret_cast<uint8_t*>(_p1.data_ptr());
    auto p2 = reinterpret_cast<uint8_t*>(_p2.data_ptr());
    auto p3 = reinterpret_cast<uint8_t*>(_p3.data_ptr());
    auto p4 = reinterpret_cast<uint8_t*>(_p4.data_ptr());
    auto p5 = reinterpret_cast<uint8_t*>(_p5.data_ptr());
    auto p6 = reinterpret_cast<uint8_t*>(_p6.data_ptr());
    auto p7 = reinterpret_cast<uint8_t*>(_p7.data_ptr());
    auto p8 = reinterpret_cast<uint8_t*>(_p8.data_ptr());
    auto p9 = reinterpret_cast<uint8_t*>(_p9.data_ptr());
    auto stream = at::xpu::getCurrentXPUStream();
    auto dpcpp_queue = stream.queue();

      switch(i0){
        case 1006:   // sdp for MLA
          esimd_kernel_sdp_mla(p0, p1, p2, p3, p4, p5, p6, i1, i2, i3, i4, i5, i6, f0, dpcpp_queue);
        break;
        case 4004:
          esimd_kernel_dsa_qk_attn(p0, p1, p2, p3, p4, i1, i2, i3, dpcpp_queue);
        break;
        default:
          printf("---------- esimd kernel op not supported, op is %lld ----------\n", i0);
        break;
      }
      return _p9;
    }